# ========================================
# Lab Inventory Management Tool
# Environment Configuration
# ========================================

# ===== SECURITY SETTINGS =====
# IMPORTANT: Change this to a random, unique string!
# Generate at: https://randomkeygen.com/
SECRET_KEY=CHANGE-THIS-TO-RANDOM-SECRET-KEY-FOR-PRODUCTION

# ===== EMAIL CONFIGURATION =====
# Your company's SMTP server settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@company.com
SMTP_PASSWORD=your-email-password

# Email addresses for notifications
ADMIN_EMAIL=admin@company.com
MANAGER_EMAIL=manager@company.com
SENDER_EMAIL=lab-inventory-noreply@company.com
EMAIL_DOMAIN=@company.com

# ===== ADMIN CREDENTIALS =====
# Default admin login credentials
# CHANGE these after first login!
ADMIN_NT_ID=ADMIN
ADMIN_PASSWORD=Admin@123

# ===== APPLICATION SETTINGS =====
# Server configuration
HOST=0.0.0.0
PORT=5000

# ===== NOTES =====
# - All email addresses must be valid
# - SMTP settings depend on your email provider
# - For Gmail, you may need to enable "Less secure app access"
# - For Office 365, use: smtp.office365.com, port 587, TLS enabled
# - For internal mail servers, consult your IT department
